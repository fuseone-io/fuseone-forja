{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true
  },
  "description": "With run_id: state, start and end of a run, its stages, the attempt in flight out of the contract's limit with every attempt's gates, the model tokens and compute minutes it used with their estimated cost, what its workspace was refused on the way out, and every request it made to its registry proxy. Without run_id: the runs that match the filters, newest first, one page at a time, under list, with the per-repository totals of every matching run; the run fields outside list are then empty.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "description": "next_cursor of the previous page",
        "type": "string"
      },
      "limit": {
        "description": "runs per page, 1 to 200; 50 when omitted",
        "type": "integer"
      },
      "repository": {
        "description": "list only the runs of this repository, in owner/name form",
        "type": "string"
      },
      "run_id": {
        "description": "identifier of one run; omit it to list runs",
        "type": "string"
      },
      "since": {
        "description": "RFC3339 instant; list only the runs started at or after it",
        "type": "string"
      },
      "state": {
        "description": "list only the runs in this state: queued, running, succeeded or failed",
        "type": "string"
      },
      "tool": {
        "description": "list only the runs of this tool, such as forja.implement",
        "type": "string"
      },
      "until": {
        "description": "RFC3339 instant; list only the runs started before it",
        "type": "string"
      }
    },
    "type": "object"
  },
